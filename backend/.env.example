# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_hosting
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration (CRITICAL FOR SECURITY)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=30m          # 30 minutes as requested
JWT_REFRESH_EXPIRES_IN=7d          # 7 days for refresh tokens

# Security Settings
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Redis (for session storage/caching)
REDIS_HOST=localhost
REDIS_PORT=6379